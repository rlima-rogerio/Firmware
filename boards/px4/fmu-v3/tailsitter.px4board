# Tailsitter UAV (UFMG) variant of px4_fmu-v3: build with `make px4_fmu-v3_tailsitter`.
# Applied on top of default.px4board; only disables what the single-motor tailsitter does not use.
# Kept on purpose: VTOL/MC/FW control, ekf2, mavlink, uxrce_dds_client, logger, SIH, autotune, fake_gps.
# Hardware (2026-10-01, sensors status): MPU6000 (SPI), MS5611 (SPI), IST8310 (I2C), MS4525DO airspeed,
# PWM ESC + servos on MAIN via px4io, PPM RC, no CAN devices.

# No CAN devices
CONFIG_DRIVERS_UAVCAN=n

# Not used / legacy estimators (VTOL starts only ekf2)
CONFIG_MODULES_GYRO_FFT=n
CONFIG_MODULES_LOCAL_POSITION_ESTIMATOR=n
CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=n
CONFIG_MODULES_TEMPERATURE_COMPENSATION=n

# Peripherals not installed
CONFIG_COMMON_DISTANCE_SENSOR=n
CONFIG_COMMON_OPTICAL_FLOW=n
CONFIG_COMMON_TELEMETRY=n
CONFIG_COMMON_INS=n
CONFIG_MODULES_GIMBAL=n
CONFIG_DRIVERS_CAMERA_CAPTURE=n
CONFIG_DRIVERS_CAMERA_TRIGGER=n
CONFIG_MODULES_CAMERA_FEEDBACK=n
CONFIG_DRIVERS_IRLOCK=n
CONFIG_MODULES_LANDING_TARGET_ESTIMATOR=n
CONFIG_DRIVERS_BATT_SMBUS=n
CONFIG_DRIVERS_SMART_BATTERY_BATMON=n
CONFIG_MODULES_ESC_BATTERY=n
CONFIG_DRIVERS_ADC_ADS1115=n
CONFIG_DRIVERS_PCA9685_PWM_OUT=n
CONFIG_DRIVERS_PWM_INPUT=n
CONFIG_DRIVERS_HEATER=n
CONFIG_DRIVERS_DSHOT=n

# Other vehicle types
CONFIG_MODULES_ROVER_POS_CONTROL=n
CONFIG_MODULES_UUV_ATT_CONTROL=n
CONFIG_MODULES_UUV_POS_CONTROL=n

# Test-only system commands
CONFIG_SYSTEMCMDS_SERIAL_TEST=n
CONFIG_SYSTEMCMDS_SD_BENCH=n
CONFIG_SYSTEMCMDS_SD_STRESS=n
CONFIG_SYSTEMCMDS_REFLECT=n

# Sensors: keep only what is on the board (+ common GPS-module compasses)
CONFIG_DRIVERS_IMU_ANALOG_DEVICES_ADIS16448=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20608G=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20948=n
CONFIG_DRIVERS_IMU_INVENSENSE_MPU9250=n
CONFIG_DRIVERS_IMU_L3GD20=n
CONFIG_DRIVERS_IMU_LSM303D=n
CONFIG_COMMON_BAROMETERS=n
CONFIG_DRIVERS_BAROMETER_MS5611=y
CONFIG_COMMON_MAGNETOMETER=n
CONFIG_DRIVERS_MAGNETOMETER_ISENTEK_IST8310=y
CONFIG_DRIVERS_MAGNETOMETER_HMC5883=y
CONFIG_DRIVERS_MAGNETOMETER_QMC5883L=y
CONFIG_COMMON_DIFFERENTIAL_PRESSURE=n
CONFIG_DRIVERS_DIFFERENTIAL_PRESSURE_MS4525DO=y
